# Local Postgres (OrbStack / Docker): `docker compose up -d` from repo root
DATABASE_URL="postgresql://teamcomposer:teamcomposer@127.0.0.1:5433/teamcomposer"

# Hosted (Neon, RDS, etc.) — use your provider’s connection string
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Vercel + Neon defaults to the Neon serverless driver automatically,
# but you can force it:
# DATABASE_CLIENT="neon"

# Optional: lock down /admin and /api/admin/* (username + password for /admin/login)
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="use-a-long-random-password"
